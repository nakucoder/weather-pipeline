{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ListWeatherData",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::miami-weather-pipeline-juan",
      "Condition": {
        "StringLike": {
          "s3:prefix": "miami-weather/*"
        }
      }
    },
    {
      "Sid": "S3ReadWriteWeatherData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::miami-weather-pipeline-juan/miami-weather/*"
    },
    {
      "Sid": "CloudWatchLogsCreateGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-2:*:*"
    },
    {
      "Sid": "CloudWatchLogsWrite",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:*:log-group:/aws/lambda/miami-weather-*:*"
    }
  ]
}
